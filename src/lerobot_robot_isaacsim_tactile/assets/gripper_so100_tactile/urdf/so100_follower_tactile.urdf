  <!-- upper_arm_link -->
  <link name="upper_arm_link">
    <inertial>
      <origin xyz="-0.0898471 -0.00838224 0.0184089" rpy="0 0 0"/>
      <mass value="0.103"/>
      <inertia ixx="4.08002e-05" ixy="-1.97819e-05" ixz="-4.03016e-08" iyy="0.000147318" iyz="8.97326e-09" izz="0.000142487"/>
    </inertial>
    <visual>
      <origin xyz="-0.11257 -0.0155 0.0187" rpy="-3.14159 0 -1.5708"/>
      <geometry><mesh filename="../meshes/sts3215_03a_v1.stl"/></geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="-0.11257 -0.0155 0.0187" rpy="-3.14159 0 -1.5708"/>
      <geometry><mesh filename="../meshes/sts3215_03a_v1.stl"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.065085 0.012 0.0182" rpy="3.14159 0 0"/>
      <geometry><mesh filename="../meshes/upper_arm_so101_v1.stl"/></geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.065085 0.012 0.0182" rpy="3.14159 0 0"/>
      <geometry><mesh filename="../meshes/upper_arm_so101_v1.stl"/></geometry>
    </collision>
  </link>

  <!-- lower_arm_link -->
  <link name="lower_arm_link">
    <inertial>
      <origin xyz="-0.0980701 0.00324376 0.0182831" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="2.87438e-05" ixy="7.41152e-06" ixz="1.26409e-06" iyy="0.000159844" iyz="-4.90188e-08" izz="0.00014529"/>
    </inertial>
    <visual>
      <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 0 0"/>
      <geometry><mesh filename="../meshes/under_arm_so101_v1.stl"/></geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 0 0"/>
      <geometry><mesh filename="../meshes/under_arm_so101_v1.stl"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.0648499 -0.032 0.018" rpy="-3.14159 0 0"/>
      <geometry><mesh filename="../meshes/motor_holder_so101_wrist_v1.stl"/></geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="-0.0648499 -0.032 0.018" rpy="-3.14159 0 0"/>
      <geometry><mesh filename="../meshes/motor_holder_so101_wrist_v1.stl"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.1224 0.0052 0.0187" rpy="-3.14159 0 -3.14159"/>
      <geometry><mesh filename="../meshes/sts3215_03a_v1.stl"/></geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="-0.1224 0.0052 0.0187" rpy="-3.14159 0 -3.14159"/>
      <geometry><mesh filename="../meshes/sts3215_03a_v1.stl"/></geometry>
    </collision>
  </link>

  <!-- wrist_link -->
  <link name="wrist_link">
    <inertial>
      <origin xyz="-0.000103312 -0.0386143 0.0281156" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="3.68263e-05" ixy="1.7893e-08" ixz="-5.28128e-08" iyy="2.5391e-05" iyz="3.6412e-06" izz="2.1e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.0424 0.0306" rpy="1.5708 1.5708 0"/>
      <geometry><mesh filename="../meshes/sts3215_03a_no_horn_v1.stl"/></geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="0 -0.0424 0.0306" rpy="1.5708 1.5708 0"/>
      <geometry><mesh filename="../meshes/sts3215_03a_no_horn_v1.stl"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0"/>
      <geometry><mesh filename="../meshes/wrist_roll_pitch_so101_v2.stl"/></geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0"/>
      <geometry><mesh filename="../meshes/wrist_roll_pitch_so101_v2.stl"/></geometry>
    </collision>
  </link>

  <!-- gripper_link — uses wrist_roll_08c.stl (Onshape, tactile pad mount) -->
  <!-- NOTE: visual origin matches SO-101 reference pose; tune after IsaacSim inspection -->
  <link name="gripper_link">
    <inertial>
      <origin xyz="0.000213627 0.000245138 -0.025187" rpy="0 0 0"/>
      <mass value="0.087"/>
      <inertia ixx="2.75087e-05" ixy="-3.35241e-07" ixz="-5.7352e-06" iyy="4.33657e-05" iyz="-5.17847e-08" izz="3.45059e-05"/>
    </inertial>
    <!-- motor body (unchanged) -->
    <visual>
      <origin xyz="0.0077 0.0001 -0.0234" rpy="-1.5708 0 0"/>
      <geometry><mesh filename="../meshes/sts3215_03a_v1.stl"/></geometry>
      <material name="sts3215"/>
    </visual>
    <collision>
      <origin xyz="0.0077 0.0001 -0.0234" rpy="-1.5708 0 0"/>
      <geometry><mesh filename="../meshes/sts3215_03a_v1.stl"/></geometry>
    </collision>
    <!-- wrist_roll_08c: structural bracket with tactile pad mount surface -->
    <visual>
      <origin xyz="0 -0.000218214 0.000949706" rpy="-3.14159 0 0"/>
      <geometry><mesh filename="../meshes/wrist_roll_08c.stl"/></geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0 -0.000218214 0.000949706" rpy="-3.14159 0 0"/>
      <geometry><mesh filename="../meshes/wrist_roll_08c.stl"/></geometry>
    </collision>
  </link>

  <!-- Tactile pad mount: fixed child of gripper_link.
       xyz = offset from gripper_link origin to flat pad surface centre (local frame).
       The 12x32 taxel patch pose relative to this link is set in tactile_pad.py (pad_offset / pad_quat). -->
  <link name="wrist_roll_tactile_pad_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="wrist_roll_tactile_pad_joint" type="fixed">
    <!--
      Pad sits on the FLAT INNER FACE of wrist_roll_08c (the static jaw),
      facing the moving jaw.  In gripper_link frame:
        - the jaw extends in -Z (mesh Z is flipped by the visual rpy=(-pi,0,0))
        - the moving-jaw pivot is at xyz=(0.0202, 0.0188, -0.0234), so the
          inner face of the static jaw faces +X.

      xyz=(0.005, 0, -0.06)  inner face of jaw, ~60 mm down the long axis
                             (i.e. upper-middle of jaw in the screenshot)
      rpy=(0, pi/2, 0)       rotates the pad frame so its local +Z axis is
                             aligned with gripper_link +X — surface normal
                             points toward the moving jaw, matching the
                             WarpSdfTactileSensor convention (normal_axis=2).

      Tune xyz / rpy if the 3-D taxel markers don't land on the yellow pad
      face after re-converting URDF→USD; this is a first-pass best guess.
    -->
    <origin xyz="0.005 0.0 -0.06" rpy="0 1.5707963 0"/>
    <parent link="gripper_link"/>
    <child link="wrist_roll_tactile_pad_link"/>
  </joint>

  <!-- gripper_frame_link (dummy EE frame, kept from SO-101) -->
  <link name="gripper_frame_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="gripper_frame_joint" type="fixed">
    <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0"/>
    <parent link="gripper_link"/>
    <child link="gripper_frame_link"/>
  </joint>

  <!-- moving_jaw_link — uses moving_jaw_08d.stl (Onshape, modified jaw) -->
  <!-- NOTE: visual origin matches SO-101 reference pose; tune after IsaacSim inspection -->
  <link name="moving_jaw_link">
    <inertial>
      <origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06" iyz="-1.09945e-07" izz="5.28738e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.0189" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/moving_jaw_08d.stl"/></geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0189" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/moving_jaw_08d.stl"/></geometry>
    </collision>
  </link>

  <!-- Joints — names match lerobot FeetechMotorsBus motor IDs exactly -->

  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0388353 0 0.0624" rpy="3.14159 0 -3.14159"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986"/>
  </joint>

  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.74533" upper="1.74533"/>
  </joint>

  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 0" rpy="0 0 1.5708"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.69" upper="1.69"/>
  </joint>

  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 0" rpy="0 0 -1.5708"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.65806" upper="1.65806"/>
  </joint>

  <joint name="wrist_roll" type="revolute">
    <origin xyz="0 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121"/>
  </joint>

  <joint name="gripper" type="revolute">
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 0 0"/>
    <parent link="gripper_link"/>
    <child link="moving_jaw_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
  </joint>

</robot>
