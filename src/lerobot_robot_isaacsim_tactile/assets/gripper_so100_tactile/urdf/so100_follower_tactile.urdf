<?xml version="1.0" encoding="utf-8"?>
<!-- Kinematic base: SO-101 (TheRobotStudio/SO-ARM100 @ new_calib)
     Modified meshes:
       gripper_link    -> wrist_roll_08c.stl   (Onshape, with tactile pad mount)
       moving_jaw_link -> moving_jaw_08d.stl   (Onshape, modified jaw)
     Added:
       wrist_roll_tactile_pad_link (fixed child of gripper_link, warp sensor mount)
     NOTE: visual <origin> on replaced meshes is inherited from SO-101.
     Tune xyz/rpy on those links after visual inspection in IsaacSim.
-->
<robot name="so100_follower_tactile">

  <!-- Materials -->
  <material name="3d_printed"><color rgba="1.0 0.82 0.12 1.0"/></material>
  <material name="sts3215"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <!-- base_link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0137179 -5.19711e-05 0.0334843" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000114686" ixy="-4.59787e-07" ixz="4.97151e-06" iyy="0.000136117" iyz="9.75275e-08" izz="0.000130364"/>
    </inertial>
    <visual>
      <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 0 1.5708"/>
